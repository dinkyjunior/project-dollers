  "comparison": [
    {
      "component": "Masthead, Back and breadcrumb",
      "finding": "Original high-resolution branding remains correct, centered and un-stretched. Back control and league badge fit both phone widths."
    },
    {
      "component": "Game Report hero",
      "finding": "Native silver/right-facing and navy/left-facing empty equipment remain crisp, complete and proportionate. Official identity vectors land on the shell, not the facemask. Blue/red score order, dark gold FINAL bar and quarter table preserve the reference hierarchy."
    },
    {
      "component": "Tabs and chrome hardware",
      "finding": "Four tabs preserve the approved order. Chamfered vector chrome, gold corners, blue light rails and faceted diamond marks remain consistent and sharply rendered."
    },
    {
      "component": "Snapshot and team comparison",
      "finding": "Three snapshot cells and the selected-game statistics table are aligned. Correct actual fourth-quarter values, rushing/passing differences and offence figures remain protected rather than copied from the illustrative sample."
    },
    {
      "component": "Player performance",
      "finding": "Team controls, passing/rushing/receiving selection, player row, expansion and profile control are legible. Source-recorded category rows differ from the render placeholders; fake RB/WR entries are not inserted beneath Passing."
    },
    {
      "component": "Quarter cumulative cards and actions",
      "finding": "Q1/Half/Q3/Final cards show correct cumulative values and retain the two native sapphire controls."
    },
    {
      "component": "Availability, sources, bottom navigation",
      "finding": "New native medical/document icons render. Compact inline Sources control fits the narrower phone. Availability content describes recorded participation, not an invented diagnosis. Navigation and footer follow the approved composition."
    }
