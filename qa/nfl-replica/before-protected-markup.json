ss=\"home-sport-option\" data-home-select=\"nba\" aria-pressed=\"false\" aria-label=\"Select NBA, coming soon\"><img src=\"assets/home/nba.svg\" alt=\"\" width=\"500\" height=\"500\" decoding=\"async\" /><span>NBA</span></button>\n              <button class=\"home-sport-option\" data-home-select=\"nrl\" aria-pressed=\"false\" aria-label=\"Select NRL, coming soon\"><img src=\"assets/logos/nrl.webp\" alt=\"\" width=\"500\" height=\"500\" decoding=\"async\" /><span>NRL</span></button>\n              <button class=\"home-sport-option\" data-home-select=\"ufc\" aria-pressed=\"false\" aria-label=\"Select UFC, coming soon\"><img src=\"assets/logos/ufc.svg\" alt=\"\" width=\"1250\" height=\"433\" decoding=\"async\" /><span>UFC</span></button>\n            </div>\n            <p class=\"home-availability sr-only\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\"></p>\n          </div>\n        </div>\n        <nav class=\"bottom-nav\" aria-label=\"Main navigation\">\n          <button data-open=\"home\" data-nav=\"home\"><svg class=\"icon\" aria-hidden=\"true\"><defs><linearGradient id=\"aperture-home-nav-gradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\"><stop offset=\"0%\" stop-color=\"var(--home-left)\"></stop><stop offset=\"49.9%\" stop-color=\"var(--home-left)\"></stop><stop offset=\"50%\" stop-color=\"var(--home-right)\"></stop><stop offset=\"100%\" stop-color=\"var(--home-right)\"></stop></linearGradient></defs><use href=\"assets/icons.svg#home\"></use></svg><span>Home</span></button>\n          <button data-open=\"nfl\" data-nav=\"nfl\"><svg class=\"icon\" aria-hidden=\"true\"><use href=\"assets/icons.svg#teams\"></use></svg><span data-home-teams-label>Teams</span></button>\n          <button data-shortcut=\"matchups\"><svg class=\"icon\" aria-hidden=\"true\"><use href=\"assets/icons.svg#matchups\"></use></svg><span>Matchups</span></button>\n          <button data-shortcut=\"insights\"><svg class=\"icon\" aria-hidden=\"true\"><use href=\"assets/icons.svg#