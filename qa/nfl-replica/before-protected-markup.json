ubtle-button\" data-roster-toggle aria-expanded=\"false\">Show complete roster</button>\n              <p id=\"empty-roster\" class=\"empty-state\" role=\"status\" hidden>\n                No players are listed for this position in the current source.\n              </p>\n              <p class=\"roster-note\" id=\"roster-note\"></p>\n            </div>\n            <div\n              id=\"team-panel-schedule\"\n              role=\"tabpanel\"\n              aria-labelledby=\"team-tab-schedule\"\n              hidden\n            >\n              <h2 class=\"panel-title\" id=\"schedule-title\">Season schedule</h2>\n              <div id=\"schedule-list\"></div>\n            </div>\n            <div\n              id=\"team-panel-stats\"\n              role=\"tabpanel\"\n              aria-labelledby=\"team-tab-stats\"\n              hidden\n            >\n              <div id=\"team-stats-content\"></div>\n            </div>\n            <div\n              id=\"team-panel-matchups\"\n              role=\"tabpanel\"\n              aria-labelledby=\"team-tab-matchups\"\n              hidden\n            >\n              <h2 class=\"panel-title\" id=\"matchup-title\">Matchup research</h2>\n              <div id=\"team-matchup\"></div>\n              <div id=\"matchup-research\"></div>\n            </div>\n          </div>\n        </div>\n        <nav class=\"bottom-nav\" aria-label=\"Main navigation\">\n          <button data-open=\"home\" data-nav=\"home\">\n            <svg class=\"icon\" aria-hidden=\"true\">\n              <use href=\"assets/icons.svg#home\"></use></svg\n            ><span>Home</span>\n          </button>\n          <button data-open=\"nfl\" data-nav=\"nfl\">\n            <svg class=\"icon\" aria-hidden=\"true\">\n              <use href=\"assets/icons.svg#teams\"></use></svg\n            ><span>Teams</span>\n          </button>\n          <button data-shortcut=\"matchups\">\n            <svg class=\"icon\" aria-hidden=\"true\">\n              